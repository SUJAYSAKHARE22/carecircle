# Copy to .env and adjust. All values are optional.
CARECIRCLE_DB=data/carecircle.db
CARECIRCLE_TIMEZONE=Asia/Kolkata
CARECIRCLE_CHECKIN_DEADLINE=10:00
CARECIRCLE_GRACE_MINUTES=60
CARECIRCLE_REMINDER_GRACE_MINUTES=45
CARECIRCLE_ALERT_DEDUPE_MINUTES=30
CARECIRCLE_HOST=127.0.0.1
CARECIRCLE_PORT=8000
# Set a token to require "Authorization: Bearer <token>" on /mcp
CARECIRCLE_MCP_TOKEN=
# Extra Host headers accepted when exposed through a tunnel, e.g. my-app.ngrok.app
CARECIRCLE_ALLOWED_HOSTS=
# Stage 4 (optional)
CARECIRCLE_TELEGRAM_BOT_TOKEN=
