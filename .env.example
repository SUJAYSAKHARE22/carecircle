# Copy to .env and adjust. Every value is optional.

# --- storage & time -------------------------------------------------------
CARECIRCLE_DB=data/carecircle.db
CARECIRCLE_TIMEZONE=Asia/Kolkata
CARECIRCLE_CHECKIN_DEADLINE=10:00      # elders are expected to check in by this local time
CARECIRCLE_GRACE_MINUTES=60            # nudge during grace, alert after it
CARECIRCLE_REMINDER_GRACE_MINUTES=45
CARECIRCLE_ALERT_DEDUPE_MINUTES=30
CARECIRCLE_DIGEST_TIME=20:00           # evening summary to caregivers
CARECIRCLE_TICK_SECONDS=30             # background monitor interval

# --- network & security ---------------------------------------------------
CARECIRCLE_HOST=127.0.0.1
CARECIRCLE_PORT=8000
# Require "Authorization: Bearer <token>" on /mcp and /api. Strongly recommended off-localhost.
CARECIRCLE_MCP_TOKEN=
# Extra Host headers to accept when behind a tunnel/proxy, e.g. my-app.ngrok.app
CARECIRCLE_ALLOWED_HOSTS=

# --- notifications (free) --------------------------------------------------
# Create a bot with @BotFather, then: carecircle link-telegram <Name> <chat_id>
CARECIRCLE_TELEGRAM_BOT_TOKEN=

# --- demo ---------------------------------------------------------------------
CARECIRCLE_DEMO=0                      # 1 = seed demo family + enable the time-travel controls

# --- optional LLM (any OpenAI-compatible endpoint: Groq, Gemini, OpenRouter, Ollama) ---
CARECIRCLE_LLM_BASE_URL=
CARECIRCLE_LLM_MODEL=
CARECIRCLE_LLM_API_KEY=
CARECIRCLE_LLM_TIMEOUT=6
